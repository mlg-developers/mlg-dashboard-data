APP_NAME="Clinical Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://clinicaldashboard.mloganzila.or.tz

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=your-remote-db-host
DB_PORT=3306
DB_DATABASE=dashboard_live
DB_USERNAME=dashboard_user
DB_PASSWORD=change-me

CACHE_STORE=redis
CACHE_PREFIX=clinicaldashboard-live
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=clinicaldashboard.mloganzila.or.tz
SESSION_COOKIE=clinicaldashboard_live_session
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=dashboard_redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=clinicaldashboard.mloganzila.or.tz

DASHBOARD_API_BASE_URL=http://192.168.235.250/labsms/swagger/dashboard
DASHBOARD_API_USERNAME=mnh-mlg-client
DASHBOARD_API_PASSWORD=change-me

# Gap detection calendar
# 0=Sunday, 6=Saturday
DASHBOARD_NON_OPERATIONAL_WEEKDAYS=0
# Comma-separated YYYY-MM-DD dates
DASHBOARD_EXCLUDED_DATES=

# --- TV display dashboards (CLINICS TODAY / DOCTORS & PATIENTS) ---
# Credentials are shared with DASHBOARD_API_USERNAME / DASHBOARD_API_PASSWORD above.
TV_API_CLINIC_WEEKDAYS_URL=http://192.168.235.250/labsms/swagger/clinic_weekdays
TV_API_CLINIC_DOCTORS_URL=http://192.168.235.250/labsms/swagger/clinic_doctor_details
TV_API_DASHBOARD_URL=http://192.168.235.250/labsms/swagger/dashboard
TV_TIMEZONE=Africa/Dar_es_Salaam
# seconds the TV data is cached on the server (one HIS call serves every TV)
TV_CACHE_SECONDS=10
# floorCode:Name pairs. Leave empty until the codes are verified, e.g. 001:Ground Floor,002:First Floor
TV_FLOOR_NAMES=
# doctors shown per clinic: assigned = every doctor Jeeva lists (default) | active = only doctors with patients today
TV_DOCTOR_VISIBILITY=assigned
# visit statuses that count as consulted when ANY of consDoctor, consDoctName, doctConsDt, doctConsTm has data (V = vitals taken at triage)
TV_CONSULT_DATA_STATUSES=V
